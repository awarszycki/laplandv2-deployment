:80 {
    root * /srv
    encode gzip

    # 1. Przekieruj API do backendu (zachowaj /api prefix)
    handle /api/* {
        reverse_proxy lapland_backend:8000
    }

    # 2. Przekieruj Healthcheck do backendu
    handle /health {
        reverse_proxy lapland_backend:8000
    }

    # 3. Pliki statyczne (JS, CSS, assets)
    handle /assets/* {
        file_server
    }

    # 4. SPA routing — wszystko inne → index.html
    handle {
        try_files {path} /index.html
        file_server
    }

    log
}
